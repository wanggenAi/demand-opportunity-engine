    "post_stream": {
      "posts": [
        {
          "id": 1919774,
          "username": "XpressCS",
          "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/x/d78d45/{size}.png",
          "created_at": "2026-10-21T21:32:13.731Z",
          "cooked": "<p>Hi,</p>\n<p>Is there a Shopify-compatible app that allows my customers to sign up for re-stock notifications, and allows us to send out re-stock email notifications to my customers, but only based on available inventory? I.E. if I add 8 items back to stock then the first 8 customers on the notify list get emails?</p>",
          "post_number": 1,
          "post_type": 1,
          "posts_count": 3,
          "updated_at": "2026-10-21T21:32:13.731Z",
          "reply_count": 0,
          "reply_to_post_number": null,
          "quote_count": 0,
          "incoming_link_count": 3,
          "reads": 12,
          "readers_count": 11,
          "score": 17.4,
          "yours": false,
