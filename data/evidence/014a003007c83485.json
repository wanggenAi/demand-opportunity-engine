    "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lachitha Vanikam | Premium B2B Bulk Nut & Saffron Supplier</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        brand: {\n                            brown: '#4A2E1B',\n                            orange: '#E07A5F',\n                            cream: '#F7F5F0',\n                            gold: '#F2CC8F',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"bg-brand-cream text-gray-800 font-sans antialiased\">\n\n    <!-- Top Banner -->\n    <div class=\"bg-brand-brown text-brand-gold text-xs py-2 px-4 text-center tracking-wider font-semibold uppercase\">\n        FSSAI Certified Quality • Securing Global & Domestic Supply Chains\n    </div>\n\n    <!-- Navigation -->\n    <nav class=\"bg-white shadow-sm sticky top-0 z-50\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between h-20 items-center\">\n                <div class=\"flex-shrink-0\">\n                    <span class=\"text-2xl font-bold tracking-tight text-brand-brown\">LACHITHA<span class=\"text-brand-orange\">VANIKAM</span></span>\n                    <p class=\"text-[10px] text-gray-500 uppercase tracking-widest font-semibold\">Premium B2B Wholesale</p>\n                </div>\n                <div class=\"hidden md:flex space-x-8 text-sm font-medium text-gray-700\">\n                    <a href=\"#about\" class=\"hover:text-brand-orange transition\">About Us</a>\n                    <a href=\"#catalogue\" class=\"hover:text-brand-orange transition\">Product Catalogue</a>\n                    <a href=\"#specifications\" class=\"hover:text-brand-orange transition\">Specifications</a>\n                    <a href=\"#inquiry\" class=\"hover:text-brand-orange transition\">Order MOQ Calculator</a>\n                </div>\n                <div>\n                    <a href=\"#inquiry\" class=\"bg-brand-brown text-white px-5 py-2.5 rounded text-sm font-semibold hover:bg-brand-orange transition shadow-sm\">Request Wholesale Quote</a>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative bg-brand-brown overflow-hidden py-24 sm:py-32\">\n        <div class=\"absolute inset-0 opacity-10 bg-[radial-gradient(#F2CC8F_1px,transparent_1px)] [background-size:16px_16px]\"></div>\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid md:grid-cols-2 gap-12 items-center\">\n            <div>\n                <span class=\"inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-orange/20 text-brand-gold mb-6 border border-brand-orange/30\">\n                    Premium Institutional Supply\n                </span>\n                <h1 class=\"text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight\">\n                    Premium Bulk Ingredients for Global Food & Cosmetic Industries\n                </h1>\n                <p class=\"mt-6 text-lg text-brand-cream/80 max-w-xl\">\n                    Lachitha Vanikam delivers FSSAI-certified, verified-purity almonds and premium saffron tailored specifically for high-end confectionery, sweet manufacturing, and cosmetic formulation.\n                </p>\n                <div class=\"mt-10 flex flex-wrap gap-4\">\n                    <a href=\"#inquiry\" class=\"bg-brand-orange text-white px-6 py-3 rounded font-semibold text-sm hover:bg-white hover:text-brand-brown transition\">\n                        Submit Bulk RFQ\n                    </a>\n                    <a href=\"#catalogue\" class=\"border border-brand-gold text-brand-gold px-6 py-3 rounded font-semibold text-sm hover:bg-brand-gold/10 transition\">\n                        View Product Matrix\n                    </a>\n                </div>\n            </div>\n            <div class=\"hidden md:block relative\">\n                <div class=\"aspect-square bg-gradient-to-tr from-brand-orange/20 to-brand-gold/20 rounded-2xl border border-brand-gold/30 p-8 flex flex-col justify-between backdrop-blur-sm\">\n                    <div class=\"border-b border-brand-gold/20 pb-4\">\n                        <p class=\"text-xs text-brand-gold uppercase tracking-widest\">Global Export Capabilities</p>\n                        <p class=\"text-xl text-white font-bold mt-1\">Domestic & International Procurement</p>\n                    </div>\n                    <div class=\"space-y-4 my-6\">\n                        <div class=\"flex justify-between items-center text-sm\">\n                            <span class=\"text-brand-cream/70\">Almond Kernel MOQ:</span>\n                            <span class=\"text-white font-semibold\">120 kg (Bulk Drums)</span>\n                        </div>\n                        <div class=\"flex justify-between items-center text-sm\">\n                            <span class=\"text-brand-cream/70\">Pure Saffron MOQ:</span>\n                            <span class=\"text-white font-semibold\">100 Grams (Sealed Tins)</span>\n                        </div>\n                        <div class=\"flex justify-between items-center text-sm\">\n                            <span class=\"text-brand-cream/70\">Compliance Status:</span>\n                            <span class=\"text-emerald-400 font-semibold flex items-center\">✓ Full FSSAI Clearance</span>\n                        </div>\n                    </div>\n                    <div class=\"bg-brand-brown/50 border border-brand-gold/20 p-4 rounded text-xs text-brand-cream/80\">\n                        Optimized logistics pipelines serving major seaport and air cargo networks for immediate processing.\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- About Sector Alignment -->\n    <section id=\"about\" class=\"py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"text-center max-w-3xl mx-auto\">\n            <h2 class=\"text-xs font-bold uppercase tracking-widest text-brand-orange\">Industrial Target Matrices</h2>\n            <p class=\"mt-3 text-3xl font-extrabold text-brand-brown\">Engineered to Support High-Volume Production Standards</p>\n            <p class=\"mt-4 text-gray-600\">\n                We specialize exclusively in business-to-business bulk procurement. By streamlining our operations to focus on verified agricultural compliance and transparent material grading, we fulfill raw ingredient mandates reliably.\n            </p>\n        </div>\n\n        <div class=\"mt-16 grid md:grid-cols-2 gap-8\">\n            <div class=\"bg-white p-8 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-brand-brown\">\n                <div class=\"w-12 h-12 bg-brand-cream rounded-lg flex items-center justify-center text-brand-brown text-xl font-bold mb-6\">01</div>\n                <h3 class=\"text-xl font-bold text-brand-brown\">The Almond Oil & Sweets Industries</h3>\n                <p class=\"mt-4 text-gray-600 text-sm leading-relaxed\">\n                    Providing dense, premium, uniform almond kernels boasting optimized oil yields and optimal moisture levels for mass grinding, confectionery paste production, and cold-pressed processing.\n                </p>\n            </div>\n            <div class=\"bg-white p-8 rounded-xl shadow-sm border border-gray-100 border-l-4 border-l-brand-orange\">\n                <div class=\"w-12 h-12 bg-brand-cream rounded-lg flex items-center justify-center text-brand-orange text-xl font-bold mb-6\">02</div>\n                <h3 class=\"text-xl font-bold text-brand-brown\">High-End Confectionery & Cosmetics</h3>\n                <p class=\"mt-4 text-gray-600 text-sm leading-relaxed\">\n                    Sourcing deep-red, pure stigma saffron with maximum crocin intensity coloring profiles. Perfect for luxury dessert accents, organic skin formulations, and specialized Ayurvedic production scales.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    <!-- Interactive Catalogue & Specs Product Section -->\n    <section id=\"catalogue\" class=\"py-20 bg-white border-t border-b border-gray-100\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-12\">\n                <div>\n                    <h2 class=\"text-xs font-bold uppercase tracking-widest text-brand-orange\">Verified Product Portfolio</h2>\n                    <p class=\"mt-2 text-3xl font-extrabold text-brand-brown\">B2B Core Ingredient Specifications</p>\n                </div>\n                <p class=\"text-sm text-gray-500 max-w-md mt-4 md:mt-0\">\n                    All shipments undergo thorough quality verification parameters and feature complete batch tracking records for institutional compliance audits.\n                </p>\n            </div>\n\n            <div class=\"grid md:grid-cols-2 gap-12\">\n                <!-- Product 1: Almonds -->\n                <div class=\"bg-brand-cream/40 rounded-2xl p-8 border border-brand-gold/30 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex justify-between items-start\">\n                            <div>\n                                <h3 class=\"text-2xl font-bold text-brand-brown\">Premium Whole Almonds</h3>\n                                <p class=\"text-xs uppercase tracking-widest text-brand-orange font-semibold mt-1\">Grade A Industrial Bulk</p>\n                            </div>\n                            <span class=\"bg-brand-brown text-white text-xs font-bold px-3 py-1 rounded\">MOQ: 120 KG</span>\n                        </div>\n                        <p class=\"mt-4 text-gray-600 text-sm\">\n                            Uniform kernel selection calibrated for heavy industrial usage. Ideal consistency profiles for wholesale marzipan, nut butter, sliced confection garnishes, and high-yield cold press oil extraction facilities.\n                        </p>\n                        \n                        <div id=\"specifications\" class=\"mt-8 space-y-3\">\n                            <h4 class=\"text-xs font-bold text-brand-brown uppercase tracking-wider\">Technical Data Parameters:</h4>\n                            <div class=\"grid grid-cols-2 gap-2 text-xs border-t border-gray-200/60 pt-2\">\n                                <span class=\"text-gray-500\">Moisture Level:</span>\n                                <span class=\"font-semibold text-right text-gray-800\">&lt; 5.5% Maximum</span>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-2 text-xs border-t border-gray-200/60 pt-2\">\n                                <span class=\"text-gray-500\">Purity Content:</span>\n                                <span class=\"font-semibold text-right text-gray-800\">99.8% Minimum Purity</span>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-2 text-xs border-t border-gray-200/60 pt-2\">\n                                <span class=\"text-gray-500\">Packaging Type:</span>\n                                <span class=\"font-semibold text-right text-gray-800\">Vacuum Sealed Box / Heavy Drums</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-8\">\n                        <a href=\"#inquiry\" class=\"block text-center bg-brand-brown text-white text-sm font-semibold py-3 rounded hover:bg-brand-orange transition\">\n                            Configure Bulk Almond Order\n                        </a>\n                    </div>\n                </div>\n\n                <!-- Product 2: Saffron -->\n                <div class=\"bg-brand-cream/40 rounded-2xl p-8 border border-brand-gold/30 flex flex-col justify-between\">\n                    <div>\n                        <div class=\"flex justify-between items-start\">\n                            <div>\n                                <h3 class=\"text-2xl font-bold text-brand-brown\">Pure Stigma Saffron</h3>\n                                <p class=\"text-xs uppercase tracking-widest text-brand-orange font-semibold mt-1\">Super Negin Export Quality</p>\n                            </div>\n                            <span class=\"bg-brand-orange text-white text-xs font-bold px-3 py-1 rounded\">MOQ: 100 GRAMS</span>\n                        </div>\n                        <p class=\"mt-4 text-gray-600 text-sm\">\n                            Hand-harvested premium single-origin threads rich in aromatic safranal concentrations and intensive crocin attributes. Fulfills the strict quality standards of luxury cosmetics and premium food processing.\n                        </p>\n                        \n                        <div class=\"mt-8 space-y-3\">\n                            <h4 class=\"text-xs font-bold text-brand-brown uppercase tracking-wider\">Technical Data Parameters:</h4>\n                            <div class=\"grid grid-cols-2 gap-2 text-xs border-t border-gray-200/60 pt-2\">\n                                <span class=\"text-gray-500\">Crocin (Color Intensity):</span>\n                                <span class=\"font-semibold text-right text-gray-800\">Category I (&gt; 230)</span>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-2 text-xs border-t border-gray-200/60 pt-2\">\n                                <span class=\"text-gray-500\">Additive Status:</span>\n                                <span class=\"font-semibold text-right text-gray-800\">100% Zero Synthetic / Organic</span>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-2 text-xs border-t border-gray-200/60 pt-2\">\n                                <span class=\"text-gray-500\">Packaging Type:</span>\n                                <span class=\"font-semibold text-right text-gray-800\">Hermetic Light-Proof Tins</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-8\">\n                        <a href=\"#inquiry\" class=\"block text-center bg-brand-orange text-white text-sm font-semibold py-3 rounded hover:bg-brand-brown transition\">\n                            Configure Bulk Saffron Order\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Interactive MOQ Calculator & Lead Capture Section -->\n    <section id=\"inquiry\" class=\"py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"bg-brand-brown rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden\">\n            <div class=\"absolute top-0 right-0 w-64 h-64 bg-brand-orange/10 rounded-full blur-3xl -mr-20 -mt-20\"></div>\n            \n            <div class=\"text-center mb-10 relative z-10\">\n                <h2 class=\"text-xs font-bold uppercase tracking-widest text-brand-gold\">B2B Trade Engagement Portal</h2>\n                <p class=\"mt-2 text-3xl font-extrabold\">Instant Bulk Pricing & Order Validation</p>\n                <p class=\"mt-3 text-sm text-brand-cream/70\">\n                    Adjust product parameters below to review mandatory order logistics validation thresholds.\n                </p>\n            </div>\n\n            <!-- Client Scripted Interactive Component -->\n            <div class=\"bg-white text-gray-800 p-6 sm:p-8 rounded-2xl relative z-10 shadow-inner\">\n                <form onsubmit=\"event.preventDefault(); alert('Lead configuration registered. Lachitha Vanikam wholesale division will contact you with a formal proforma invoice.');\">\n                    <div class=\"grid sm:grid-cols-2 gap-6\">\n                        <div>\n                            <label class=\"block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2\">Select Target Commodity</label>\n                            <select id=\"productSelect\" onchange=\"updateMOQLabel()\" class=\"w-full bg-gray-50 border border-gray-200 rounded p-3 text-sm focus:outline-none focus:border-brand-orange\">\n                                <option value=\"almonds\">Premium Bulk Almonds</option>\n                                <option value=\"saffron\">Pure Stigma Saffron</option>\n                            </select>\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2\">Target Volume Quantity</label>\n                            <div class=\"relative\">\n                                <input type=\"number\" id=\"volumeInput\" oninput=\"validateQuantity()\" required class=\"w-full bg-gray-50 border border-gray-200 rounded p-3 text-sm focus:outline-none focus:border-brand-orange\" placeholder=\"Enter target volume\">\n                                <span id=\"unitLabel\" class=\"absolute right-3 top-3.5 text-xs font-semibold text-gray-400\">kg</span>\n                            </div>\n                            <p id=\"moqWarning\" class=\"text-xs text-red-500 mt-1 font-medium hidden\">Warning: Volume matches below institutional threshold.</p>\n                            <p id=\"moqInfo\" class=\"text-[11px] text-gray-400 mt-1\">Mandatory Institutional MOQ Target: <span id=\"moqValue\" class=\"font-bold text-brand-brown\">120 kg</span></p>\n                        </div>\n                    </div>\n\n                    <div class=\"grid sm:grid-cols-2 gap-6 mt-6\">\n                        <div>\n                            <label class=\"block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2\">Target Manufacturing Sector</label>\n                            <select required class=\"w-full bg-gray-50 border border-gray-200 rounded p-3 text-sm focus:outline-none focus:border-brand-orange\">\n                                <option value=\"\">Select your industry sector...</option>\n                                <option value=\"sweets\">Sweets & Commercial Confectionery</option>\n                                <option value=\"oil\">Almond Oil & Extraction Refining</option>\n                                <option value=\"cosmetics\">Luxury Cosmetics Formulation</option>\n                                <option value=\"export\">International Bulk Resale Trading</option>\n                            </select>\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2\">Logistics Destination Network</label>\n                            <select required class=\"w-full bg-gray-50 border border-gray-200 rounded p-3 text-sm focus:outline-none focus:border-brand-orange\">\n                                <option value=\"domestic\">Domestic Clearing (Within India Infrastructure)</option>\n                                <option value=\"international\">Cross-Border International Export Channels</option>\n                            </select>\n                        </div>\n                    </div>\n\n                    <div class=\"border-t border-gray-100 my-8 pt-6 grid sm:grid-cols-2 gap-4\">\n                        <div>\n                            <label class=\"block text-xs font-bold text-gray-500 mb-1\">Company Corporate Name</label>\n                            <input type=\"text\" required class=\"w-full border-b border-gray-200 py-2 text-sm focus:outline-none focus:border-brand-orange bg-transparent\" placeholder=\"Enterprise entity name\">\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold text-gray-500 mb-1\">Official B2B Contact Email</label>\n                            <input type=\"email\" required class=\"w-full border-b border-gray-200 py-2 text-sm focus:outline-none focus:border-brand-orange bg-transparent\" placeholder=\"procurement@company.com\">\n                        </div>\n                    </div>\n\n                    <button type=\"submit\" class=\"w-full bg-brand-brown text-white font-bold py-4 rounded-xl text-sm hover:bg-brand-orange transition uppercase tracking-wider shadow-md\">\n                        Transmit Institutional RFP Lead\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer Area -->\n    <footer class=\"bg-brand-brown text-brand-cream/60 text-xs py-12 border-t border-brand-gold/10\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6\">\n            <div>\n                <p class=\"font-bold text-white text-sm\">LACHITHA VANIKAM</p>\n                <p class=\"mt-1\">Institutional B2B Bulk Agricultural Ingredient Supply Framework</p>\n            </div>\n            <div class=\"text-center md:text-right\">\n                <p>Compliance Matrix: FSSAI Certified Operations</p>\n                <p class=\"mt-1 text-[10px]\">© 2026 Lachitha Vanikam. All Global Commercial Rights Reserved.</p>\n            </div>\n        </div>\n    </footer>\n\n    <!-- Interactive Logic Controller -->\n    <script>\n        function updateMOQLabel() {\n            var selectedProduct = document.getElementById(\"productSelect\").value;\n            var unitLabel = document.getElementById(\"unitLabel\");\n            var moqValue = document.getElementById(\"moqValue\");\n            var volumeInput = document.getElementById(\"volumeInput\");\n\n            if (selectedProduct === \"almonds\") {\n                unitLabel.innerText = \"kg\";\n                moqValue.innerText = \"120 kg\";\n                volumeInput.placeholder = \"Enter target weight in kg\";\n            } else {\n                unitLabel.innerText = \"grams\";\n                moqValue.innerText = \"100 grams\";\n                volumeInput.placeholder = \"Enter target weight in grams\";\n            }\n            validateQuantity();\n        }\n\n        function validateQuantity() {\n            var selectedProduct = document.getElementById(\"productSelect\").value;\n            var quantity = parseFloat(document.getElementById(\"volumeInput\").value);\n            var warningElement = document.getElementById(\"moqWarning\");\n\n            if (isNaN(quantity)) {\n                warningElement.classList.add(\"hidden\");\n                return;\n            }\n\n            var limit = (selectedProduct === \"almonds\") ? 120 : 100;\n\n            if (quantity < limit) {\n                warningElement.classList.remove(\"hidden\");\n            } else {\n                warningElement.classList.add(\"hidden\");\n            }\n        }\n    </script>\n</body>\n</html>\n",
