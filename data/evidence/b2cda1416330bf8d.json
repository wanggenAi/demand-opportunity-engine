    "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Elevate Sports KE — Gear up. Play higher.</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\n:root{\n  --bg: #F4F6F4;\n  --navy: #111C24;\n  --navy-light: #1A2934;\n  --lime: #C4F53B;\n  --lime-hover: #b0e02a;\n  --white: #FFFFFF;\n  --text: #111C24;\n  --text-muted: #5C6B73;\n  --border: #E0E5E2;\n  --warning-bg: #E5F3D9;\n  --warning-text: #3A5A40;\n  --radius: 24px;\n  --radius-sm: 16px;\n  --shadow: 0 4px 20px rgba(0,0,0,0.04);\n}\nhtml{scroll-behavior:smooth}\nbody{\n  background: var(--bg); color: var(--text);\n  font-family: 'Inter', sans-serif;\n  line-height: 1.5; -webkit-font-smoothing: antialiased; overflow-x:hidden;\n}\nh1, h2, h3, h4, .brand { font-family: 'Outfit', sans-serif; font-weight: 700; }\na { color: inherit; text-decoration: none; }\nbutton, input, textarea { font: inherit; color: inherit; }\nbutton { cursor: pointer; border: none; background: none; }\nimg { max-width: 100%; display: block; object-fit: cover; }\n.wrap { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 20px; }\n\n/* ---------- Top Bar & Header ---------- */\n.top-bar {\n  background: var(--navy); color: #fff; text-align: center;\n  font-size: 11px; font-weight: 500; letter-spacing: 1px;\n  text-transform: uppercase; padding: 12px 20px;\n}\nheader {\n  background: var(--bg); padding: 24px 0 16px;\n  position: sticky; top: 0; z-index: 50;\n  border-bottom: 1px solid var(--border);\n}\n.header-inner { display: flex; justify-content: space-between; align-items: center; }\n.brand-box h1 { font-size: 22px; letter-spacing: -0.5px; text-transform: uppercase; color: var(--navy); line-height: 1; }\n.brand-box p { font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #8FA31E; text-transform: uppercase; margin-top: 6px; }\n.cart-btn {\n  background: var(--lime); color: var(--navy);\n  padding: 12px 24px; border-radius: 999px;\n  font-weight: 700; font-size: 14px; text-align: center; line-height: 1.2;\n  transition: transform 0.2s;\n}\n.cart-btn:hover { transform: scale(1.05); }\n.cart-btn span { display: block; font-size: 12px; font-weight: 600; }\n\n/* ---------- Hero ---------- */\n.hero { padding: 20px 0; }\n.hero-card {\n  background: var(--navy); color: #fff;\n  border-radius: var(--radius); padding: 40px 30px 0;\n  overflow: hidden; position: relative;\n}\n.hero-text { max-width: 600px; margin-bottom: 40px; position: relative; z-index: 2; }\n.hero-eyebrow {\n  color: var(--lime); font-size: 12px; font-weight: 800;\n  letter-spacing: 2px; text-transform: uppercase; margin-bottom: 20px;\n}\n.hero h2 { font-size: clamp(40px, 8vw, 56px); line-height: 1.05; letter-spacing: -1.5px; margin-bottom: 20px; }\n.hero p { font-size: 16px; color: #A5B5C1; margin-bottom: 32px; line-height: 1.6; }\n.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }\n.btn {\n  display: inline-flex; align-items: center; justify-content: center;\n  border-radius: 999px; font-weight: 700; font-size: 15px;\n  padding: 14px 28px; transition: all 0.2s;\n}\n.btn-lime { background: var(--lime); color: var(--navy); }\n.btn-lime:hover { background: var(--lime-hover); }\n.btn-outline-white { border: 1px solid rgba(255,255,255,0.3); color: #fff; }\n.btn-outline-white:hover { border-color: #fff; background: rgba(255,255,255,0.1); }\n.btn-navy { background: var(--navy); color: #fff; width: 100%; }\n.btn-navy:hover { background: var(--navy-light); }\n\n.hero-img-wrap {\n  width: 100%; height: 300px; margin: 0 auto;\n  position: relative; display: flex; justify-content: center; align-items: flex-end;\n}\n.hero-img-wrap img { width: 100%; max-width: 400px; height: auto; object-fit: contain; }\n\n/* ---------- Trust Cards ---------- */\n.trust { padding: 20px 0; display: grid; gap: 16px; }\n.trust-card {\n  background: var(--white); border-radius: var(--radius-sm);\n  padding: 24px; display: flex; gap: 20px; align-items: flex-start;\n  border: 1px solid var(--border); box-shadow: var(--shadow);\n}\n.trust-card .icon { font-size: 24px; line-height: 1; }\n.trust-card h4 { font-size: 16px; font-weight: 700; margin-bottom: 4px; color: var(--navy); }\n.trust-card p { font-size: 14px; color: var(--text-muted); }\n\n/* ---------- Shop Section ---------- */\n.shop-section { padding: 40px 0; }\n.section-head { margin-bottom: 24px; }\n.section-head h3 { font-size: 32px; letter-spacing: -1px; color: var(--navy); margin-bottom: 8px; }\n.section-head p { font-size: 15px; color: var(--text-muted); max-width: 600px; }\n\n.filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }\n.chip {\n  background: var(--white); color: #1A73E8; border: 1px solid var(--border);\n  border-radius: 999px; padding: 10px 20px; font-size: 14px; font-weight: 600;\n  transition: all 0.2s;\n}\n.chip.on { background: var(--navy); color: #fff; border-color: var(--navy); }\n.chip:hover:not(.on) { border-color: #1A73E8; }\n\n.warning-box {\n  background: var(--warning-bg); color: var(--warning-text);\n  border-radius: var(--radius-sm); padding: 24px; margin-bottom: 32px;\n  font-size: 14px; line-height: 1.6; border: 1px solid #D4E8C8;\n}\n.warning-box strong { font-weight: 700; }\n\n/* ---------- Bundles ---------- */\n.bundles-section { padding: 20px 0 40px; }\n.bundles-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }\n@media(min-width: 768px) { .bundles-grid { grid-template-columns: repeat(3, 1fr); } }\n.bundle-card {\n  background: var(--white); border: 1px solid var(--border);\n  border-radius: var(--radius); padding: 24px;\n  display: flex; flex-direction: column;\n  box-shadow: var(--shadow);\n}\n.bundle-card .emoji { font-size: 32px; margin-bottom: 16px; }\n.bundle-card h4 { font-size: 20px; font-weight: 700; margin-bottom: 12px; line-height: 1.2; color: var(--navy); }\n.bundle-card p { font-size: 14px; color: var(--text-muted); margin-bottom: 24px; flex-grow: 1; }\n.bundle-card .btn { padding: 12px 16px; font-size: 14px; }\n\n/* ---------- Team Quote ---------- */\n.team-quote { padding: 20px 0 40px; }\n.team-card {\n  background: var(--navy); color: #fff;\n  border-radius: var(--radius); padding: 40px 30px;\n}\n.team-card .hero-eyebrow { margin-bottom: 16px; }\n.team-card h3 { font-size: 32px; margin-bottom: 16px; letter-spacing: -1px; }\n.team-card p { font-size: 15px; color: #A5B5C1; margin-bottom: 28px; }\n.team-card .btn { width: 100%; }\n\n/* ---------- How Ordering Works ---------- */\n.how-section { padding: 40px 0; }\n.how-grid { display: grid; gap: 16px; }\n@media(min-width: 768px) { .how-grid { grid-template-columns: repeat(3, 1fr); } }\n.how-card {\n  background: var(--white); border-radius: var(--radius-sm);\n  padding: 24px; border: 1px solid var(--border);\n}\n.how-card .num { font-size: 14px; color: var(--text-muted); margin-bottom: 8px; }\n.how-card h4 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--navy); }\n.how-card p { font-size: 14px; color: var(--text-muted); }\n\n/* ---------- FAQ ---------- */\n.faq-section { padding: 20px 0 60px; }\n.faq-list { display: grid; gap: 12px; }\ndetails {\n  background: var(--white); border: 1px solid var(--border);\n  border-radius: 12px; padding: 0 20px;\n}\nsummary {\n  list-style: none; cursor: pointer; padding: 20px 0;\n  font-weight: 600; font-size: 15px; color: var(--navy);\n  display: flex; align-items: center; gap: 12px;\n}\nsummary::-webkit-details-marker { display: none; }\nsummary::before { content: \"▶\"; font-size: 10px; color: var(--navy); transition: transform 0.2s; }\ndetails[open] summary::before { transform: rotate(90deg); }\ndetails p { font-size: 14px; color: var(--text-muted); padding-bottom: 20px; padding-left: 22px; }\n\n/* ---------- Catalogue Grid ---------- */\n.catalogue-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap: 16px; margin-top: 20px; }\n.product-card {\n  background: var(--white); border: 1px solid var(--border);\n  border-radius: var(--radius-sm); padding: 20px;\n  display: flex; flex-direction: column;\n}\n.product-card .cat { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #1A73E8; margin-bottom: 8px; }\n.product-card h4 { font-size: 18px; color: var(--navy); margin-bottom: 4px; }\n.product-card p { font-size: 13px; color: var(--text-muted); margin-bottom: 16px; flex-grow: 1; }\n.tiers { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.tier {\n  border: 1px solid var(--border); border-radius: 12px; padding: 10px;\n  display: flex; flex-direction: column; align-items: center; background: var(--bg);\n  transition: all 0.2s;\n}\n.tier:hover { border-color: var(--lime); background: #F8FFE5; }\n.tier .t { font-size: 10px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; }\n.tier .p { font-size: 14px; font-weight: 700; color: var(--navy); margin-top: 2px; }\n.tier .u { font-size: 10px; color: var(--text-muted); font-weight: 500; }\n\n/* ---------- Footer ---------- */\nfooter { background: var(--navy); color: #fff; padding: 60px 20px 40px; }\n.footer-inner { max-width: 1100px; margin: 0 auto; }\n.footer-brand h2 { font-size: 28px; text-transform: uppercase; letter-spacing: -0.5px; margin-bottom: 8px; }\n.footer-brand p { font-size: 12px; font-weight: 700; color: var(--lime); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 24px; }\n.footer-desc { color: #A5B5C1; font-size: 15px; max-width: 500px; margin-bottom: 40px; line-height: 1.6; }\n.footer-contact h4 { font-size: 18px; margin-bottom: 12px; }\n.footer-contact p { color: #A5B5C1; font-size: 14px; margin-bottom: 24px; }\n.footer-copy { color: #5C6B73; font-size: 13px; }\n\n/* ---------- Drawer / Kit Bag ---------- */\n.drawer { position: fixed; inset: 0; z-index: 100; pointer-events: none; }\n.drawer.open { pointer-events: auto; }\n.drawer-bg { position: absolute; inset: 0; background: rgba(17,28,36,0.6); opacity: 0; transition: .3s; backdrop-filter: blur(4px); }\n.drawer.open .drawer-bg { opacity: 1; }\n.panel { position: absolute; top: 0; right: 0; height: 100%; width: 100%; max-width: 400px; background: var(--bg); display: flex; flex-direction: column; transform: translateX(100%); transition: transform .3s cubic-bezier(.4,0,.2,1); }\n.drawer.open .panel { transform: translateX(0); }\n.panel-head { display: flex; align-items: center; justify-content: space-between; padding: 24px; border-bottom: 1px solid var(--border); background: #fff; }\n.panel-head h3 { font-size: 20px; color: var(--navy); }\n.close { width: 36px; height: 36px; border-radius: 50%; background: var(--bg); display: grid; place-items: center; font-size: 18px; color: var(--text-muted); }\n.close:hover { background: #E0E5E2; color: var(--navy); }\n.panel-body { flex: 1; overflow-y: auto; padding: 24px; }\n.panel-foot { border-top: 1px solid var(--border); padding: 24px; display: grid; gap: 16px; background: #fff; }\n.ci { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border); align-items: center; }\n.ci:last-child { border-bottom: none; }\n.ci .info { flex: 1; }\n.ci .info h5 { font-size: 15px; color: var(--navy); font-weight: 600; }\n.ci .info .meta { font-size: 12px; color: var(--text-muted); margin-top: 4px; }\n.ci .info .meta b { color: var(--navy); }\n.ci .amt { font-size: 15px; font-weight: 700; color: var(--navy); }\n.ci .rm { color: #ccc; font-size: 18px; padding: 4px; }\n.ci .rm:hover { color: #ff4d4d; }\n.empty { text-align: center; padding: 60px 20px; color: var(--text-muted); font-size: 15px; }\n.empty .big { font-size: 48px; margin-bottom: 16px; }\n.total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; font-weight: 600; color: var(--navy); }\n.total b { font-size: 24px; font-weight: 800; }\n.panel-foot input { width: 100%; padding: 14px; border: 1px solid var(--border); border-radius: 12px; font-size: 14px; outline: none; }\n.panel-foot input:focus { border-color: var(--navy); }\n.btn-wa { background: #25D366; color: #fff; }\n.btn-wa:hover { background: #20BA56; }\n</style>\n</head>\n<body>\n\n<!-- ══════════ TOP BAR ══════════ -->\n<div class=\"top-bar\">\n  KENYAN FOOTBALL · FITNESS · TEAMWEAR — SPORT FOR EVERYONE\n</div>\n\n<!-- ══════════ HEADER ══════════ -->\n<header>\n  <div class=\"wrap header-inner\">\n    <div class=\"brand-box\">\n      <h1>Elevate Sports KE</h1>\n      <p>Sport for everyone. Performance for all.</p>\n    </div>\n    <button class=\"cart-btn\" id=\"openCart\">\n      Kit bag<br><span id=\"cartCount\">(0)</span>\n    </button>\n  </div>\n</header>\n\n<!-- ══════════ HERO ══════════ -->\n<section class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-card\">\n      <div class=\"hero-text\">\n        <div class=\"hero-eyebrow\">THE GAME STARTS WITH THE RIGHT GEAR</div>\n        <h2>Gear up.<br>Play higher.</h2>\n        <p>Affordable football, fitness and team essentials for grassroots players, competitive athletes, coaches, gyms and active families across Kenya.</p>\n        <div class=\"hero-actions\">\n          <a href=\"#shop\" class=\"btn btn-lime\">Find your gear →</a>\n          <a href=\"#\" class=\"btn btn-outline-white\" id=\"heroWa\">Ask us on WhatsApp</a>\n        </div>\n      </div>\n      <div class=\"hero-img-wrap\">\n        <!-- Clean football image matching the vibe -->\n        <img src=\"https://images.unsplash.com/photo-1614632537423-1e6c2e7e0aab?auto=format&fit=crop&q=80&w=800\" alt=\"Football\">\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ══════════ TRUST CARDS ══════════ -->\n<section class=\"wrap\">\n  <div class=\"trust\">\n    <div class=\"trust-card\">\n      <div class=\"icon\">🤝</div>\n      <div>\n        <h4>Ask before you pay</h4>\n        <p>We confirm availability, final price and delivery first.</p>\n      </div>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"icon\">⚽</div>\n      <div>\n        <h4>Grassroots to elite</h4>\n        <p>Options for individual players, coaches, gyms and teams.</p>\n      </div>\n    </div>\n    <div class=\"trust-card\">\n      <div class=\"icon\">📦</div>\n      <div>\n        <h4>Order what you need</h4>\n        <p>Single-item enquiries and bulk team quotes welcome.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ══════════ POPULAR BUNDLES ══════════ -->\n<section class=\"bundles-section wrap\">\n  <div class=\"section-head\">\n    <h3>Popular starter requests</h3>\n    <p>Quick enquiry bundles to help customers tell us what they need. Final contents and quote are confirmed with you.</p>\n  </div>\n  <div class=\"bundles-grid\">\n    <div class=\"bundle-card\">\n      <div class=\"emoji\">⚽</div>\n      <h4>Grassroots Player Pack</h4>\n      <p>Ask for a value quote on a training ball, shin guards, socks and a water bottle.</p>\n      <button class=\"btn btn-navy\" data-bundle=\"player\">Get a player-pack quote</button>\n    </div>\n    <div class=\"bundle-card\">\n      <div class=\"emoji\">🧢</div>\n      <h4>Coach's Training Pack</h4>\n      <p>Ask for cones, marker discs, bibs and a pump for your next training session.</p>\n      <button class=\"btn btn-navy\" data-bundle=\"coach\">Get a coach-pack quote</button>\n    </div>\n    <div class=\"bundle-card\">\n      <div class=\"emoji\">💪</div>\n      <h4>Gym Starter Pack</h4>\n      <p>Ask for resistance bands, skipping rope and gym gloves at an affordable combined price.</p>\n      <button class=\"btn btn-navy\" data-bundle=\"gym\">Get a gym-pack quote</button>\n    </div>\n  </div>\n</section>\n\n<!-- ══════════ TEAM QUOTE ══════════ -->\n<section class=\"team-quote wrap\">\n  <div class=\"team-card\">\n    <div class=\"hero-eyebrow\">FOR CLUBS, SCHOOLS & ACADEMIES</div>\n    <h3>Equip the whole squad.</h3>\n    <p>Need match kits, training wear, balls, bibs, cones or bulk accessories? Send your team size, items and deadline. We'll help you request a clear quote before you commit.</p>\n    <a href=\"#contact\" class=\"btn btn-lime\" style=\"display:inline-flex; width:auto;\">Request team quote</a>\n  </div>\n</section>\n\n<!-- ══════════ HOW ORDERING WORKS ══════════ -->\n<section class=\"how-section wrap\">\n  <div class=\"section-head\">\n    <h3>How ordering works</h3>\n  </div>\n  <div class=\"how-grid\">\n    <div class=\"how-card\">\n      <div class=\"num\">01</div>\n      <h4>Choose or ask</h4>\n      <p>Pick a product or tell us your sport, budget, size and quantity.</p>\n    </div>\n    <div class=\"how-card\">\n      <div class=\"num\">02</div>\n      <h4>We confirm</h4>\n      <p>We check supplier availability, specifications, final price and delivery.</p>\n    </div>\n    <div class=\"how-card\">\n      <div class=\"num\">03</div>\n      <h4>You decide</h4>\n      <p>If you approve the quote, we agree on payment and fulfilment. No pressure to buy.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ══════════ SHOP THE ESSENTIALS ══════════ -->\n<section id=\"shop\" class=\"shop-section wrap\">\n  <div class=\"section-head\">\n    <h3>Shop the essentials</h3>\n    <p>Start with useful, accessible gear. Tap enquire to check the exact item, size and price.</p>\n  </div>\n  \n  <div class=\"filters\" id=\"filters\"></div>\n\n  <div class=\"warning-box\">\n    <strong>Honest ordering:</strong> Every product has a LOW entry-level price and a HIGH upgraded-quality price. These are target launch prices, not confirmed live offers or proof of stock. We confirm the exact model, size, supplier availability, final price and delivery charge before you pay. The LOW and HIGH options must be matched to real supplier models and quality before sale. If our sourcing cost cannot support a displayed price, we will quote honestly instead of selling at a loss. No fake stock claims and no payment just to enquire.\n  </div>\n\n  <div class=\"catalogue-grid\" id=\"grid\"></div>\n</section>\n\n<!-- ══════════ FAQ ══════════ -->\n<section class=\"faq-section wrap\">\n  <div class=\"faq-list\">\n    <details>\n      <summary>Do you have stock ready?</summary>\n      <p>No, we operate a pre-order model. We source your gear after you confirm your order, which allows us to keep prices low without holding inventory.</p>\n    </details>\n    <details>\n      <summary>Can I order just one item?</summary>\n      <p>Yes. Whether it's one pair of boots or a single ball, we'll quote you and source it.</p>\n    </details>\n    <details>\n      <summary>Can I get a team or academy quote?</summary>\n      <p>Absolutely. Use the \"Request team quote\" button or message us on WhatsApp with your requirements and we'll send a tailored quote.</p>\n    </details>\n    <details>\n      <summary>Where do you deliver?</summary>\n      <p>We deliver Kenya-wide. Delivery costs are calculated separately and confirmed with you before payment.</p>\n    </details>\n  </div>\n</section>\n\n<!-- ══════════ FOOTER ══════════ -->\n<footer>\n  <div class=\"footer-inner\">\n    <div class=\"footer-brand\">\n      <h2>Elevate Sports KE</h2>\n      <p>Sport for everyone. Performance for all.</p>\n    </div>\n    <div class=\"footer-desc\">\n      Affordable sports essentials for the people who make the game happen — players, coaches, teams, gyms and active families.\n    </div>\n    <div class=\"footer-contact\">\n      <h4>Let's get you equipped.</h4>\n      <p>WhatsApp enquiries are answered with availability, a clear quote and delivery details before payment.</p>\n    </div>\n    <div class=\"footer-copy\">\n      © Elevate Sports KE\n    </div>\n  </div>\n</footer>\n\n<!-- ══════════ DRAWER ══════════ -->\n<div class=\"drawer\" id=\"drawer\" aria-hidden=\"true\">\n  <div class=\"drawer-bg\" data-close></div>\n  <aside class=\"panel\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"panel-head\">\n      <h3>Kit bag</h3>\n      <button class=\"close\" data-close aria-label=\"Close\">✕</button>\n    </div>\n    <div class=\"panel-body\" id=\"cartBody\"></div>\n    <div class=\"panel-foot\">\n      <div class=\"total\"><span>Indicative total</span><b id=\"cartTotal\">KSh 0</b></div>\n      <input id=\"custName\" placeholder=\"Your name\">\n      <input id=\"custArea\" placeholder=\"Delivery area (e.g. Nairobi)\">\n      <button class=\"btn btn-wa\" id=\"sendQuote\">Send enquiry on WhatsApp →</button>\n      <p style=\"font-size:11px; text-align:center; color:var(--text-muted)\">Indicative only. Delivery is quoted separately.</p>\n    </div>\n  </aside>\n</div>\n\n<script>\nconst WA_NUMBER = \"254714353751\";\n\nconst PRODUCTS = [\n  { id:\"boots\",    cat:\"Football\",    name:\"Football Boots\",       low:3500, high:4500, note:\"Firm ground & turf options\" },\n  { id:\"jerseys\",  cat:\"Teamwear\",    name:\"Fan Jerseys\",           low:1500, high:2500, note:\"Club & national kits\" },\n  { id:\"balls\",    cat:\"Football\",    name:\"Training Balls\",        low:1500, high:3500, note:\"Size 4 & 5, training and match\" },\n  { id:\"shin\",     cat:\"Football\",    name:\"Shin Guards\",           low:700,  high:1500, note:\"Slip-in and strap styles\" },\n  { id:\"gk\",       cat:\"Football\",    name:\"Goalkeeper Gloves\",     low:1500, high:3500, note:\"Grip and padded options\" },\n  { id:\"cones\",    cat:\"Training\",    name:\"Training Cones\",        low:100,  high:250,  note:\"Sold per cone, bulk welcome\", unit:\"each\" },\n  { id:\"bibs\",     cat:\"Training\",    name:\"Training Bibs\",         low:350,  high:650,  note:\"Sold per bib, multiple colours\", unit:\"each\" },\n  { id:\"bands\",    cat:\"Fitness\",     name:\"Resistance Bands\",      low:800,  high:1800, note:\"Home and gym sets\" },\n  { id:\"rope\",     cat:\"Fitness\",     name:\"Skipping Ropes\",        low:350,  high:1200, note:\"Speed and weighted options\" },\n  { id:\"custom\",   cat:\"Teamwear\",    name:\"Custom Teamwear\",       low:1800, high:3000, note:\"Names, numbers & club colours\" },\n  { id:\"bottle\",   cat:\"Accessories\", name:\"Sports Bottles\",        low:500,  high:1200, note:\"Training and match-day sizes\" },\n  { id:\"gymgloves\",cat:\"Fitness\",     name:\"Gym Gloves\",            low:500,  high:1500, note:\"Padded palm, grip support\" }\n];\n\nconst BUNDLES = [\n  { id:\"player\", items:[\"balls\",\"shin\",\"bottle\"], qty:{balls:1, shin:1, bottle:1} },\n  { id:\"coach\", items:[\"cones\",\"bibs\",\"balls\"], qty:{cones:10, bibs:10, balls:1} },\n  { id:\"gym\", items:[\"bands\",\"rope\",\"gymgloves\"], qty:{bands:1, rope:1, gymgloves:1} }\n];\n\nconst $  = (s, r=document) => r.querySelector(s);\nconst $$ = (s, r=document) => [...r.querySelectorAll(s)];\nconst money = n => \"KSh \" + n.toLocaleString(\"en-KE\");\nconst byId = id => PRODUCTS.find(p => p.id === id);\n\nlet cart = [];\ntry { cart = JSON.parse(localStorage.getItem(\"eske_cart\")) || []; } catch(e){ cart = []; }\n\nfunction save(){ try { localStorage.setItem(\"eske_cart\", JSON.stringify(cart)); } catch(e){} }\n\nfunction addItem(id, tier){\n  const key = id + \"|\" + tier;\n  const found = cart.find(c => c.key === key);\n  if (found) { found.qty += 1; } else { cart.push({ key, id, tier, qty: 1 }); }\n  save(); renderCart(); openDrawer();\n}\n\nfunction removeItem(key){\n  cart = cart.filter(c => c.key !== key);\n  save(); renderCart();\n}\n\nfunction cartTotal(){\n  return cart.reduce((sum, c) => {\n    const p = byId(c.id); if (!p) return sum;\n    return sum + p[c.tier] * c.qty;\n  }, 0);\n}\n\nconst cats = [\"All gear\", ...new Set(PRODUCTS.map(p => p.cat))];\nlet activeCat = \"All gear\";\n\nfunction renderFilters(){\n  $(\"#filters\").innerHTML = cats.map(c =>\n    `<button class=\"chip${c === activeCat ? \" on\" : \"\"}\" data-cat=\"${c}\">${c}</button>`\n  ).join(\"\");\n  $$(\"#filters .chip\").forEach(b => b.addEventListener(\"click\", () => {\n    activeCat = b.dataset.cat; renderFilters(); renderGrid();\n  }));\n}\n\nfunction renderGrid(){\n  const list = activeCat === \"All gear\" ? PRODUCTS : PRODUCTS.filter(p => p.cat === activeCat);\n  $(\"#grid\").innerHTML = list.map(p => `\n    <article class=\"product-card\">\n      <div class=\"cat\">${p.cat}</div>\n      <h4>${p.name}</h4>\n      <p>${p.note || \"\"}</p>\n      <div class=\"tiers\">\n        <button class=\"tier\" data-id=\"${p.id}\" data-tier=\"low\">\n          <span class=\"t\">LOW</span>\n          <span class=\"p\">${money(p.low)}</span>\n          ${p.unit ? `<span class=\"u\">per ${p.unit}</span>` : \"\"}\n        </button>\n        <button class=\"tier\" data-id=\"${p.id}\" data-tier=\"high\">\n          <span class=\"t\">HIGH</span>\n          <span class=\"p\">${money(p.high)}</span>\n          ${p.unit ? `<span class=\"u\">per ${p.unit}</span>` : \"\"}\n        </button>\n      </div>\n    </article>\n  `).join(\"\");\n  $$(\"#grid .tier\").forEach(b => b.addEventListener(\"click\", () => addItem(b.dataset.id, b.dataset.tier)));\n}\n\n$$(\"[data-bundle]\").forEach(btn => btn.addEventListener(\"click\", () => {\n  const b = BUNDLES.find(x => x.id === btn.dataset.bundle);\n  b.items.forEach(id => {\n    const q = b.qty?.[id] || 1;\n    for (let i = 0; i < q; i++) {\n      const key = id + \"|low\";\n      const found = cart.find(c => c.key === key);\n      if (found) found.qty += 1;\n      else cart.push({ key, id, tier: \"low\", qty: 1 });\n    }\n  });\n  save(); renderCart(); openDrawer();\n}));\n\nfunction renderCart(){\n  const body = $(\"#cartBody\");\n  const count = cart.reduce((s,c) => s + c.qty, 0);\n  const badge = $(\"#cartCount\");\n  \n  badge.textContent = \"(\" + count + \")\";\n\n  if (!cart.length){\n    body.innerHTML = `<div class=\"empty\"><div class=\"big\">🛍️</div>Your kit bag is empty.<br>Tap LOW or HIGH on any item to start.</div>`;\n    $(\"#cartTotal\").textContent = money(0);\n    return;\n  }\n\n  body.innerHTML = cart.map(c => {\n    const p = byId(c.id); if (!p) return \"\";\n    const amt = p[c.tier] * c.qty;\n    return `\n      <div class=\"ci\">\n        <div class=\"info\">\n          <h5>${p.name}${c.qty > 1 ? ` × ${c.qty}` : \"\"}</h5>\n          <div class=\"meta\"><b>${c.tier.toUpperCase()}</b> tier${p.unit ? \" · per \" + p.unit : \"\"}</div>\n        </div>\n        <div class=\"amt\">${money(amt)}</div>\n        <button class=\"rm\" data-rm=\"${c.key}\" aria-label=\"Remove\">✕</button>\n      </div>\n    `;\n  }).join(\"\");\n\n  $(\"#cartTotal\").textContent = money(cartTotal());\n  $$(\"[data-rm]\", body).forEach(b => b.addEventListener(\"click\", () => removeItem(b.dataset.rm)));\n}\n\nfunction openDrawer(){ $(\"#drawer\").classList.add(\"open\"); $(\"#drawer\").setAttribute(\"aria-hidden\",\"false\"); document.body.style.overflow=\"hidden\"; }\nfunction closeDrawer(){ $(\"#drawer\").classList.remove(\"open\"); $(\"#drawer\").setAttribute(\"aria-hidden\",\"true\"); document.body.style.overflow=\"\"; }\n\n$(\"#openCart\").addEventListener(\"click\", openDrawer);\n$$(\"[data-close]\").forEach(el => el.addEventListener(\"click\", closeDrawer));\ndocument.addEventListener(\"keydown\", e => { if (e.key === \"Escape\") closeDrawer(); });\n\nfunction waLink(msg){ return \"https://wa.me/\" + WA_NUMBER + \"?text=\" + encodeURIComponent(msg); }\nfunction openWa(msg){ window.open(waLink(msg), \"_blank\", \"noopener\"); }\n\n$(\"#sendQuote\").addEventListener(\"click\", () => {\n  const name = $(\"#custName\").value.trim();\n  const area = $(\"#custArea\").value.trim();\n\n  let msg = \"Hi Elevate Sports KE 👋\\nI'd like a quote, please.\\n\\n\";\n  if (cart.length){\n    msg += \"*MY ENQUIRY*\\n\";\n    cart.forEach((c, i) => {\n      const p = byId(c.id);\n      msg += `${i+1}. ${p.name}${c.qty > 1 ? \" x\" + c.qty : \"\"} — ${c.tier.toUpperCase()} — ${money(p[c.tier] * c.qty)}\\n`;\n    });\n    msg += `\\nIndicative total: ${money(cartTotal())}\\n(Delivery quoted separately)\\n\\n`;\n  } else {\n    msg += \"*GENERAL ENQUIRY*\\n\";\n  }\n  if (name) msg += \"Name: \" + name + \"\\n\";\n  if (area) msg += \"Delivery area: \" + area + \"\\n\";\n  msg += \"\\nPlease confirm the exact model, availability and final price.\";\n  openWa(msg);\n});\n\n$(\"#heroWa\").addEventListener(\"click\", e => {\n  e.preventDefault();\n  openWa(\"Hi Elevate Sports KE 👋 I'd like to know more about your gear.\");\n});\n\nrenderFilters();\nrenderGrid();\nrenderCart();\n</script>\n</body>\n</html>",
