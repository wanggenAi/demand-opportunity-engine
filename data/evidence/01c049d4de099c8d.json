  "source": {
    "post_stream": {
      "posts": [
        {
          "id": 1934392,
          "username": "TVR_UK",
          "avatar_template": "/user_avatar/community.shopify.com/tvr_uk/{size}/403503_2.png",
          "created_at": "2026-11-07T22:51:20.413Z",
          "cooked": "<p>We have two physical stores very close together.. within 2 miles. If a customer placed an order we would post as 1 shipment - transferring stock from one location to another to combine.</p>\n<p>We noticed recently that customers are being charged for two shipments. How do we stop this?</p>",
          "post_number": 1,
          "post_type": 1,
          "posts_count": 6,
          "updated_at": "2026-11-07T22:51:20.413Z",
          "reply_count": 0,
          "reply_to_post_number": null,
          "quote_count": 0,
          "incoming_link_count": 2,
          "reads": 8,
          "readers_count": 7,
          "score": 26.6,
          "yours": false,
          "topic_id": 711715,
          "topic_slug": "two-locations-shared-inventory-one-shipment",
          "primary_group_name": "merchant",
          "flair_name": null,
          "flair_url": null,
          "flair_bg_color": null,
          "flair_color": null,
          "flair_group_id": null,
